# Ваш API ID от my.telegram.org (не обязательно для бота, но может пригодиться)
API_ID=ваш_api_id
# Ваш API Hash от my.telegram.org
API_HASH=ваш_api_hash
# Токен бота от @BotFather
BOT_TOKEN=ваш_токен_бота
# API ключ для DeepSeek
DEEPSEEK_API_KEY=ваш_ключ_deepseek
# API ключ для Groq
GROQ_API_KEY=ваш_ключ_groq
# API ключ для OCR.space (бесплатный)
OCR_API_KEY=ваш_ключ_ocr
# API ключ для LangSearch
LANGSEARCH_API_KEY=ваш_ключ_langsearch
# ID администратора (числовой ID из Telegram) для доступа к опасным функциям (консоль, генерация модулей)
ADMIN_ID=123456789
